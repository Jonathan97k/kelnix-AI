# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# OPENCODE_API_KEY: Optional fallback AI provider (OpenCode Zen – free).
# Used automatically when Gemini fails or is not configured.
# Same free provider the opencode agent runs on: deepseek-v4-flash-free.
# Get your (free) API key at: https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://aistudio.google.com/api-keys?project=gen-lang-client-0780425261

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # Required for secure server-side ownership verification

# Cloudinary Configuration (Phase 4A)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

